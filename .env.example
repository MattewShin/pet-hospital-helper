# 브라우저에서 사용하는 공개 설정입니다. service role 키를 VITE_ 변수로 만들지 마세요.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Supabase Dashboard에서 설정을 마친 공급자만 true로 바꿉니다.
# 공급자 Client Secret을 VITE_ 환경 변수에 넣지 마세요.
VITE_AUTH_GOOGLE_ENABLED=true
VITE_AUTH_NAVER_ENABLED=false
VITE_AUTH_KAKAO_ENABLED=false

# Vercel 서버 함수(api/invitations.js)에서만 사용하는 비밀 값입니다.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# 신규 Supabase 프로젝트의 Secret key를 쓰는 경우 위 값 대신 아래 이름도 지원합니다.
SUPABASE_SECRET_KEY=

# 초대 이메일 링크가 돌아올 배포 주소입니다. 로컬은 http://localhost:5173 을 사용합니다.
APP_URL=https://YOUR_APP.vercel.app
